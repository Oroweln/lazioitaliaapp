# b2bserver base URL (no /api/v2 suffix). 10.0.2.2 is the host machine as seen from the Android emulator;
# for a physical device use your computer's LAN IP, e.g. http://192.168.1.20:4000.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Tenant slug sent as X-App-Key on every request (seeded in b2bserver's schema.sql).
EXPO_PUBLIC_APP_KEY=zoemilano
